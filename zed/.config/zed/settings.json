{
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview_font_family": ".ZedSans",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "Ubuntu Sans Mono",
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": []
  },
  "icon_theme": "Zed (Default)",
  "autosave": {
    "after_delay": {
      "milliseconds": 300
    }
  },
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark Soft",
    "dark": "GitHub Dark"
  },
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "show_completions_on_input": true,
  "languages": {
    "Lua": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": "language_server"
    }
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": "http://localhost:8081/v1/completions",
      "model": "zeta2.1",
      "prompt_format": "zeta2_1",
      "max_output_tokens": 256
    },
    "mode": "eager",
    "provider": "open_ai_compatible_api",
    "ollama": {
      "api_url": "http://localhost:11434",
      "model": "hf.co/adilkairolla/zeta-2.1-GGUF:Q5_K_M",
      "prompt_format": "zeta2_1",
      "max_output_tokens": 256
    }
  },
  "tab_bar": {
    "show": false
  }
}
